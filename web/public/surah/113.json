{"n":113,"name":"Al-Falaq","name_ar":"الفلق","ayahs":5,"bismillah":true,"verses":[{"a":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","p":{"text":"Wahai Muhammad, katakanlah: \"Aku berlindung kepada Tuhan yang menguasai waktu Shubuh","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Katakanlah: \"Aku berlindung kepada Tuhan Yang Menguasai subuh,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":2,"ar":"مِن شَرِّ مَا خَلَقَ","p":{"text":"dari sifat buruk setiap makhluk,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dari kejahatan makhluk-Nya,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","p":{"text":"dari sifat buruk malam yang gelap,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan dari kejahatan malam apabila telah gelap gulita,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":4,"ar":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","p":{"text":"dari kejahatan para ahli sihir,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan dari kejahatan wanita-wanita tukang sihir yang menghembus pada buhul-buhul,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","p":{"text":"dan dari kejahatan pendengki yang melakukan kedengkiannya.\"","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan dari kejahatan pendengki bila ia dengki\".","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}}]}