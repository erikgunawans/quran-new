{"n":101,"name":"Al-Qaari'a","name_ar":"القارعة","ayahs":11,"bismillah":true,"verses":[{"a":1,"ar":"ٱلْقَارِعَةُ","p":{"text":"Peristiwa yang mencekam.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Hari Kiamat,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":2,"ar":"مَا ٱلْقَارِعَةُ","p":{"text":"Apakah peristiwa yang mencekam itu?","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"apakah hari Kiamat itu?","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","p":{"text":"Wahai Muhammad, apakah kamu tahu tentang peristiwa yang mencekam itu?","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Tahukah kamu apakah hari Kiamat itu?","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","p":{"text":"Peristiwa yang mencekam adalah saat manusia berjatuhan bagaikan laron-laron yang berguguran.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Pada hari itu manusia adalah seperti anai-anai yang bertebaran,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","p":{"text":"Gunung-gunung bagaikan bulu-bulu yang beterbangan.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan gunung-gunung adalah seperti bulu yang dihambur-hamburkan.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","p":{"text":"Siapa saja yang bobot amal shalihnya lebih berat daripada dosanya,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Dan adapun orang-orang yang berat timbangan (kebaikan)nya,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":7,"ar":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","p":{"text":"dia akan hidup dalam surga yang menyenangkan.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"maka dia berada dalam kehidupan yang memuaskan.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","p":{"text":"Adapun siapa saja yang bobot dosanya lebih berat daripada amal shalihnya,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Dan adapun orang-orang yang ringan timbangan (kebaikan)nya,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌ","p":{"text":"tempat tinggalnya adalah neraka Hawiyah.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"maka tempat kembalinya adalah neraka Hawiyah.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","p":{"text":"Wahai Muhammad, apakah kamu tahu tentang neraka Hawiyah itu?","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Tahukah kamu apakah neraka Hawiyah itu?","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":11,"ar":"نَارٌ حَامِيَةٌۢ","p":{"text":"Neraka Hawiyah adalah api neraka yang sangat panas dan dapat melelehkan apa saja yang dibakarnya.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"(Yaitu) api yang sangat panas.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}}]}