{"n":114,"name":"An-Naas","name_ar":"الناس","ayahs":6,"bismillah":true,"verses":[{"a":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","p":{"text":"Wahai Muhammad, katakanlah: \"Aku berlindung kepada Tuhan yang menguasai manusia dan jin,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Katakanlah: \"Aku berlindung kepada Tuhan (yang memelihara dan menguasai) manusia.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":2,"ar":"مَلِكِ ٱلنَّاسِ","p":{"text":"raja manusia dan jin,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Raja manusia.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":3,"ar":"إِلَٰهِ ٱلنَّاسِ","p":{"text":"sesembahan manusia dan jin,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Sembahan manusia.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","p":{"text":"dari keburukan pembisik yang licik,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Dari kejahatan (bisikan) syaitan yang biasa bersembunyi,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","p":{"text":"yang membisikkan kejahatan ke dalam hati manusia,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"yang membisikkan (kejahatan) ke dalam dada manusia,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","p":{"text":"pembisik kejahatan dari golongan jin dan manusia.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dari (golongan) jin dan manusia.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}}]}