{"n":107,"name":"Al-Maa'un","name_ar":"الماعون","ayahs":7,"bismillah":true,"verses":[{"a":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","p":{"text":"Wahai Muhammad, apakah engkau tahu tentang orang yang mengingkari hari perhitungan amal di akhirat?","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Tahukah kamu (orang) yang mendustakan agama?","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","p":{"text":"Mereka itu adalah orang-orang yang mencurangi hak anak yatim.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Itulah orang yang menghardik anak yatim,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","p":{"text":"Mereka tidak mau mengajak orang lain untuk memberi makan orang miskin.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan tidak menganjurkan memberi makan orang miskin.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","p":{"text":"Celakalah orang-orang yang melakukan shalat,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Maka kecelakaanlah bagi orang-orang yang shalat,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","p":{"text":"tetapi mereka mengabaikan syarat dan rukunnya,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"(yaitu) orang-orang yang lalai dari shalatnya,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","p":{"text":"orang-orang yang melaksanakan shalat untuk mencari pujian orang lain,","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"orang-orang yang berbuat riya,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","p":{"text":"dan juga orang-orang yang tidak mau mendermakan hartanya untuk menolong orang lain.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan enggan (menolong dengan) barang berguna.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}}]}