{"n":112,"name":"Al-Ikhlaas","name_ar":"الإخلاص","ayahs":4,"bismillah":true,"verses":[{"a":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","p":{"text":"Wahai Muhammad, katakanlah: \"Allah adalah Tuhan Yang Esa.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Katakanlah: \"Dialah Allah, Yang Maha Esa.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","p":{"text":"Allah Maha Menjamin segala kebutuhan makhluk-Nya.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Allah adalah Tuhan yang bergantung kepada-Nya segala sesuatu.","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","p":{"text":"Allah tidak melahirkan dan tidak pula dilahirkan.","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"Dia tiada beranak dan tidak pula diperanakkan,","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}},{"a":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","p":{"text":"Tidak ada sesuatu pun yang menyamai Allah.\"","translator":"Ustadz Muhammad Thalib","translation_type":"interpretive"},"c":{"text":"dan tidak ada seorangpun yang setara dengan Dia\".","translator":"Kementerian Agama Republik Indonesia","translation_type":"literal"}}]}