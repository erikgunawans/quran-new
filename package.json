{
  "name": "quran-graphrag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quranic GraphRAG — canonical corpus ingest and knowledge-graph build",
  "scripts": {
    "ingest": "bun run src/cli.ts ingest",
    "ingest:lock": "bun run src/cli.ts ingest --update-lock",
    "verify": "bun run src/cli.ts verify",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p src/eval/tsconfig.json",
    "review:build": "bun run src/review/build-comparison.ts",
    "app:corpus": "bun run src/app/build-corpus.ts",
    "app:audio": "bun run src/app/build-audio.ts",
    "app:themes": "bun run src/app/build-themes.ts",
    "app:peta": "bun run src/app/build-peta.ts",
    "app:peta3d": "bun run src/app/build-peta-3d.ts",
    "app:design": "bun run src/app/build-design-doc.ts",
    "app:curation-sheet": "bun run src/review/build-curation-sheet.ts",
    "app:aqidah-sheet": "bun run src/review/build-aqidah-sheet.ts",
    "app:feelings-sheet": "bun run src/review/build-feelings-sheet.ts",
    "app:review-html": "bun run src/review/build-review-html.ts",
    "smoke:answer": "bun run worker/smoke-answer.ts",
    "eval:framing": "bun run src/eval/run.ts",
    "eval:answer": "bun run src/eval/answer-run.ts",
    "app:graph": "bun run src/app/build-graph.ts",
    "app:graph:derived": "bun run src/app/build-graph-derived.ts",
    "app:related": "bun run src/app/build-related-verses.ts",
    "app:juz": "bun run src/app/build-juz.ts",
    "app:hadith": "bun run src/app/build-hadith.ts",
    "app:topic-subjects": "bun run src/app/build-topic-subjects.ts",
    "app:coverage-audit": "bun run src/review/build-coverage-audit.ts",
    "dev": "bun run app:corpus && vite web --port 5173",
    "build": "bun run app:corpus && bun run app:juz && bun run app:hadith && bun run app:themes && bun run app:peta && bun run app:topic-subjects && bun run app:peta3d && bun run app:grounding-digest && vite build web",
    "demo:build": "bun run app:corpus && bun run app:juz && bun run app:topic-subjects && vite build web --config web/vite.demo.config.ts",
    "app:caveat-sheet": "bun run src/review/build-caveat-sheet.ts",
    "app:grounding-digest": "bun run src/app/build-grounding-digest.ts",
    "app:split-expansion": "bun run src/review/split-feelings-expansion.ts",
    "app:peta-graph": "bun run src/app/build-peta-graph.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "latest",
    "d3-force-3d": "^3.0.6",
    "typescript": "^5.6.0",
    "vite": "^8.1.4"
  }
}
