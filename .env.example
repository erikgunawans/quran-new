# Copy to .env (gitignored) and fill in. Bun loads .env automatically — no dotenv package needed.

# Required for `bun run app:graph:derived` (Path B2 — LLM-derived knowledge graph edges).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — defaults to anthropic/claude-sonnet-5 if unset. Any OpenRouter model slug works;
# see https://openrouter.ai/models for the current catalog.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
